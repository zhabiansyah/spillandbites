# Saat ini project TIDAK butuh environment variable apa pun — data
# tersimpan di file JSON lokal (folder /data) dan sesi login pakai cookie
# sederhana (lihat lib/auth.ts).
#
# Kalau nanti migrasi ke database & auth sungguhan, variabel semacam ini
# biasanya dibutuhkan (aktifkan/isi sesuai provider yang dipakai):
#
# DATABASE_URL=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
